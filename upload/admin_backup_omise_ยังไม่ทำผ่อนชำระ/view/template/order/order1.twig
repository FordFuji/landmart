<script>
    function updateProcessing2Processed(order_product_id) {
        $check = confirm('Confirm Invoice');
        if($check == true) {
            $.post('index.php?route=sale/order/ajaxChangeStatus2Processed&user_token={{ user_token }}', { order_product_id: order_product_id }, function(data) {
                window.location.href = 'index.php?route=sale/order/order1&user_token={{ user_token }}';
            });
        }
    }

    function cancelOrder() {
        $("#formCancel").submit();
    }

    function showUnShowSummaryData(order_id) {
        $(".order_no_" + order_id).toggle();
    }
</script>

