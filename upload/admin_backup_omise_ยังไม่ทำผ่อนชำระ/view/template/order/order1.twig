<div class="paginator" align="center">
{% for f in 1..count_page %}
    {% if f == count_page %}
        <a href="index.php?route=sale/order/order1&page={{ f }}&user_token={{ user_token }}">{{ f }}</a>
    {% elseif f == page %}
        {{ f }} |
    {% else %}
        <a href="index.php?route=sale/order/order1&page={{ f }}&user_token={{ user_token }}">{{ f }}</a> |  
    {% endif %}
{% endfor %}
</div>

{% set no = 0 %}
{% for order_product in orderCtrl %}
    <div style="display: none;" id="invoice_box_{{ order_product.order_product_id }}">
        <form action="index.php?route=sale/order/UpdateInvoiceProcessing&user_token={{ user_token }}" method="post" id="myform_{{ no }}">
        <h2>กรุณาใส่หมายเลขใบกำกับสินค้า</h2>
        <table class="table table-invoice-fill table-bordered">
