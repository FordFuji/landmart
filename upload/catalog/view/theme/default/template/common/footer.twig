<script>
$(document).ready(function() {
    
  	$('.slick1').on('init', function(event, slick){
		  

		  setTimeout(function() {
        $('.row-product').each(function(index){
            var rpd = $(this)
            var pdh = $(this).find('.product-wrapper').outerHeight();
            rpd.find('.slideleft_hh').css('height', pdh);
        });
    }, 500);


		/*$('.row-product').each(function(index){
			var pdh = $(this).find('.product-wrapper').outerHeight();
