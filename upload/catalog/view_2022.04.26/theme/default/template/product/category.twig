{{ header }}
	<div class="container-fluid ">
		<div class="row">
			<div class="col">
				<img src="asset/images/product_banner.png" class="img-fluid" alt="">
			</div>
		</div>
		<div class="wrapper_pad">
			<div class="row mt-3">
				<div class="col">
					<div class="title_product">
						<b>{{ category1.name2 }}</b>
					</div>
				</div>
			</div>
			<div class="row mb-3">
				<div class="col">
					{% if keyword == '' %}
					<nav aria-label="breadcrumb">
						<ol class="breadcrumb">
							<li class="breadcrumb-item"><a href="#">{{ category1.name }}</a></li>
							<li class="breadcrumb-item"><a href="#">{{ category2.name }}</a></li>
							<li class="breadcrumb-item active" aria-current="page">{{ category3.name }}</li>
						</ol>
					</nav>
					{% endif %}
				</div>
			</div>
			<div class="row no-gutters">
				<div class="col-md-2 filter_left">
					{{ sideProduct }}
				</div>
				<div class="col-md-10 borderti ">
					<div class="boxbox_prod">
						<div class="borderti_bot">
							<div class="row ">
								<div class="col-md-6">
								<div class="mt-2 not_found_array_ajax_filter">ค้นพบสินค้า {{ products_count }} รายการสำหรับ "{% if keyword != '' %}{{ keyword }}{% else %}{{ category3.name }}{% endif %}"</div></div>
								<div class="col-md-6 text-md-right">
									<div class="row">
										<div class="col">
											<div class="sortby">
												<select id="selectbasic" name="selectbasic" class="form-control arrow_down">
													<option value="" disabled selected>จัดเรียงตาม</option>
													<option value="1">Option one</option>
													<option value="2">Option two</option>
												</select>
											</div>
											<div class="showproduct">
												แสดง <div class="btn-group" role="group" aria-label="Basic example">
													<button type="button" class="btn btn-secondary">50</button>
													<button type="button" class="btn btn-secondary">100</button>

												</div>
												หน้า
											</div>
										</div>


									</div>

								</div>
							</div>
						</div>


						<br>
						<div class="row">
							<div class="col div_ajax_product_filter">
								
	{% for product in products %}
		{% set i = 0 %}
								<div class="slide-item each_product">
									<div class="product_cropbox">
										<div class="grad_product">
											<a href="index.php?route=product/product&path={{ product.category_id }}&product_id={{ product.product_id }}">
												<img src="{{ product.thumb }}" class="img-fluid" alt="">
											</a>
		{% if product.special != 0 %}
											<span class="savetag_new">
												SAVE
											</span>
											<div class="ribbon">
												{{ product.discount_percent|round }}%
											</div>
		{% endif %}
										</div>

										<div class="product_box_details">
		{% if product.product_landmart == 'Yes' %}
											<span class="brand_small">
												LANDMART
											</span>
		{% endif %}
											<h4>{{ product.name }}</h4>
											<span class="wishlist_new">
												<a href="#"><img src="asset/images/g2494_06.png"></a>
											</span>
											<div class="row">
												<div class="col">
													<span class="code_product">
														{{ product.model }}
													</span>
												</div>
											</div>

		{% if product.special == 0 %}
												<div class="price_discount">
													฿ {{ product.price }}
												</div>
		{% else %}
												<div class="price_original">
													฿ {{ product.price }}
												</div>
												<div class="price_discount">
													฿ {{ product.special }}
												</div>
		{% endif %}


											<!-- <div class="addselect">
												<a href="#" class="btn btn-cart-select">แสดงตัวเลือก</a>
											</div> -->
											<!-- <div class="bottom_cart"> -->
		{% for r in rows %}
			{% if r.product_id == product.product_id %}
				{% if r.quantity > 0 %}
					{% if product.isSizeColor == true %}
												<div class="addselect">
													<a href="javascript:void(0);"
														class="btn btn-cart-select more-select">แสดงตัวเลือก</a>
												</div>
					{% elseif product.isSizeColor == false %}
												<div class="qty_sm">
													<input type="text" class="form-control qty qty_{{ product.product_id }}" value="1">
												</div>
												<div class="addcart">
													<a href="javascript:cart.add({{ product.product_id }});" class="btn btn-cart-new"><img src="asset/images/cartNew_pp.png" alt=""> 	
													<span class="cartDmb">
														สั่งซื้อสินค้า
													</span></a>
												</div>
					{% endif %}
				{% else %}
												<div class="addselect" style="text-align: center;">
													<b>{{ r.name }}</b>
												</div>
				{% endif %}
			{% endif %}
		{% endfor %}
											<!-- </div> -->
										</div>
									</div>
		{% if product.isSizeColor == true %}
									<!-- โค้ดวิว ทำเลือกสี รุ่น -->
									<div class="product_cropbox" style="display:none;">
										<div class="more_chioce_box">		
			{% set i = 0 %}
			{% for size_color in sizeColor %}
				{% if product.product_id == size_color.product_id %}
					{% set i = i + 1 %}
											<div class="display-slide" rel="{{ i }}" {% if i == 1 %}style="display:block;"{% endif %}>
												<div class="row">
													<div class="col-md-4 pad_right_no">
														<img src="{{ size_color.product_option_value_image }}" class="img-fluid" alt="">
													</div>
													<div class="col-md-8 product_box_details">
														{% if product.product_landmart == 'Yes' %}
														<span class="brand_small">
															LANDMART
														</span>
														{% endif %}
														<h4>{{ product.product_name }}</h4>
														<span class="code_product">
															{{ product.model }}
														</span>
														{# {% if product.special == '0.00' %}
															<div class="price_discount">
																{{ product.price }}
															</div>
														{% else %}
															<div class="price_original">
																{{ product.price }}
															</div>
															<div class="price_discount">
																{{ product.special }}
															</div>
														{% endif %} #}
														<div class="price_discount">
															฿&nbsp;{{ size_color.price_cal|number_format(0, '.', ',') }}
														</div>
													</div>
												</div>
											</div>
				{% endif %}
			{% endfor %}
											<span class="title_select">Select more</span>
											<div class="gallery_pic select-display-slide">
			{% set i = 0 %}
			{% for sc in sizeColor %}
				{% if product.product_id == sc.product_id %}
					{% set i = i + 1 %}
												{# <li {% if i == 1 %} class="active" {% endif %} rel="{{ i }}">
													<a href="javascript:void(0)" id="{{ sc.product_option_value_id }}" class="color_size_image">
														{{ sc.name_option }}
													</a>
												</li> #}
												<li rel="{{ i }}">
													<a href="javascript:void(0)" id="{{ sc.product_option_value_id }}" class="color_size_image">
														{{ sc.name_option }}
													</a>
												</li>
				{% endif %}
			{% endfor %}
											</div>
											
											<div class="bottom_cart_more">
												<div class="qty_sm">
													<input type="text" class="form-control qtyMore_{{ product.product_id }}" value="1">
												</div>
												<div class="addcart">
													<a href="javascript:cartMore.add({{ product.product_id }});" class="btn btn-cart-new"><svg
															xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#000" class="bi bi-cart3" viewBox="0 0 16 16">
														<path
															d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l.84 4.479 9.144-.459L13.89 4H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
													</svg> 
													
														<span class="cartDmb">
														สั่งซื้อสินค้า
													</span></a>
												</div>
											</div>
										</div>
	
										<a href="javascript:void(0);" class="close-more-select">
											<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="#000" class="bi bi-x" viewBox="0 0 16 16">
												<path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
											</svg>
										</a>
									</div>
		{% endif %}
									<!-- End โค้ดวิว ทำเลือกสี รุ่น -->
								</div>
		{% set i = i + 1 %}						
	{% endfor %}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
