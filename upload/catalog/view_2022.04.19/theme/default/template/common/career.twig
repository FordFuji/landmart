									<a href="#"><img src="asset/images/career-01.jpg" class="img-fluid" alt=""></a>
								</div>
								<div class="item">
									<a href="#"><img src="asset/images/career-01.jpg" class="img-fluid" alt=""></a>
								</div>
							</div>
						</div>
						<!--	BANNER-MOBILE			-->
						<div class="d-block d-sm-block d-md-block d-lg-none d-xl-none">
							<div class="bannertop owl-carousel owl-theme">
								<div class="item">
