							</div>
						</div>


					</div>
				</div>

			</div>
		</div>
	</div>
	<div class="content_wrap mt-5">
		<div class="row mb-3">
			<div class="col">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="#">หน้าหลัก</a></li>
						<li class="breadcrumb-item active" aria-current="page">ตำแหน่งงาน
						</li>
					</ol>
				</nav>
			</div>
		</div>
		<div class="row">
			<div class="col">
				<div class="search_filter_job">
					<div class="row">
						<div class="col">
							<form action="" method="post">
							ค้นหางาน
							<div class="search_barbox">
								<input type="text" name="career_name" class="form-control" placeholder="Keyword">
							</div>
							<div class="search_barbox">
								<select id="career_category_id" name="career_category_id" class="form-control arrow_down">
									<option value="">All Job Function</option>
{% if category %}
	{% for r in category %}
									<option value="{{ r.career_category_id }}">{{ r.career_category_name }}</option>
	{% endfor %}
{% endif %}
								</select>
							</div>
							<div class="search_barbox">
								<select id="xxx" name="xxx" class="form-control arrow_down">
									<option value="" disabled selected>All Location</option>
								</select>
							</div>
							<div class="search_barbox_btn">
								<input type="submit" class="btn btn-yellow" name="submit_search" value="Search">
							</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="row mt-3">
			<div class="col">
				<div class="position">
					Position - <span class="yellotxt bigtxt">All Positions</span>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col">
{% set i = 0 %}
{% if career %}
	{% for r in career %}
		{% set i = i + 1 %}
				<div class="box_position gallery">
					<div class="left_number">{{ i }}</div>
					<div class="center_job">
						<a href="index.php?route=common/career/detail&career_id={{ r.career_id }}" class="jobdetails">{{ r.career_name }} {% if r.career_but_now == 'Yes' %}<span class="urgent">ด่วน!</span>{% endif %} {% if r.career_new == 'Yes' %}<span class="new">ใหม่</span>{% endif %}</a>
						<div class="datepost"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar4-week" viewBox="0 0 16 16">
								<path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM2 2a1 1 0 0 0-1 1v1h14V3a1 1 0 0 0-1-1H2zm13 3H1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V5z" />
								<path d="M11 7.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm-3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm-2 3a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm-3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z" />
							</svg> {{ r.career_datetime_update }}</div>
					</div>
					<div class="right_apply">
						<a href="index.php?route=common/career/detail&career_id={{ r.career_id }}" class="btn btn-yellow">สมัคร</a>
					</div>
				</div>
	{% endfor %}
{% endif %}
