{{ header }}
	<div class="container-fluid nopad">
		<div class="row">
			<div class="col">
				<div class="row">
					<div class="col-sm-12">
						<div class="d-none d-sm-none d-md-none d-lg-block d-xl-block">
							<!--	BANNER-PC			-->
							<div class="bannertop owl-carousel owl-theme">
								<div class="item">
									<a href="#"><img src="asset/images/News_head-01-01-01.jpg" class="img-fluid" alt=""></a>
								</div>
							
							</div>
						</div>
						<!--	BANNER-MOBILE			-->
						<div class="d-block d-sm-block d-md-block d-lg-none d-xl-none">
							<div class="bannertop owl-carousel owl-theme">
								<div class="item">
									<a href="#"><img src="asset/images/News_head-01-01-01.jpg" class="img-fluid" alt=""></a>
								</div>
							
							</div>
						</div>


					</div>
				</div>

			</div>
		</div>
		<div class="wrapper_pad">
		<div class="row mt-3">
			<div class="col">
				<div class="title_news_is">
			<h1>{% if newsCtrl %}{{ newsCtrl.news_topic }}{% endif %}</h1>	
				</div>
			</div>
		</div>
			<div class="row mt-3">
				<div class="col">
					<div class="title_img ">
						<img src="asset/images/title_banner.png" class="img-fluid" alt="">
					</div>
				</div>
			</div>
			<div class="row mt-3">
				<div class="col">
					<div class="datenews">
						{% if newsCtrl %}{{ newsCtrl.news_datetime}}{% endif %}
					</div>
					{% if newsCtrl %}{{ newsCtrl.news_detail }}{% endif %}
				</div>
			</div>
		
		</div>
	</div>

	<script>
		$(document).ready(function() {
			$('.bannertop').owlCarousel({
				margin: 20,
				loop: true,
				item: 1,
				autoplay: false,
				autoplayTimeout: 4000,
				autoplayHoverPause: false,
				smartSpeed: 2000,
				dots: true,
				responsive: {
					0: {
						items: 1,
						slideBy: 1,
						margin: 10,
						nav: false,

					},
					600: {
						items: 1,
						slideBy: 1,
						nav: false,

					},
					1024: {
						items: 1,
						slideBy: 1
					},
					1200: {
						items: 1,
						slideBy: 1
					}
				}
			})

		});

	</script>
{{ footer }}