														{{ product.model }}
													</span>
												</div>
											</div>

			{% if product.special == 0 %}
												<div class="price_discount">
													฿ {{ product.price }}
												</div>
			{% else %}
												<div class="price_original">
													฿ {{ product.price }}
												</div>
