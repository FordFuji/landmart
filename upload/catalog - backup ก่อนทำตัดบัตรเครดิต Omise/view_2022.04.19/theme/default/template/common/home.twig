											</a>
			{% if product.special != 0 %}
											<span class="savetag_new">
												SAVE
											</span>
											<div class="ribbon">
												{% set discount = ((product.price_pure - product.special_pure) * 100 / product.price_pure) %}
												{{ discount|round }}%
											</div>
			{% endif %}
										</div>

										<div class="product_box_details">
