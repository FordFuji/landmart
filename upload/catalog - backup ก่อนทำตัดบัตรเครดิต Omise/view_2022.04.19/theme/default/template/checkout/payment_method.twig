	<script type="text/javascript">
		$(document).ready(function() {
			$("#upload-file").prop('required', false);
			$("#datepicker").prop('required', false);
			$("#time_").prop('required', false);
			
			$(".select-display-slide > li").click(function() {
				var rel = $(this).attr("rel");
				$.post('index.php?route=checkout/payment_method/ajaxPaymentMethod', { payment_method: rel }, function(data) {
					console.log(data);
					$("#payment_method_").val(data);

					if(data == 'บัตรเครดิต / บัตรเดบิต' || data == 'เก็บเงินปลายทาง COD' || data == 'รอข้อมูล COD50%') {
						$(".is_show_online_banking").hide();
						$("#upload-file").prop('required', false);
						$("#datepicker").prop('required', false);
						$("#time_").prop('required', false);
						$(".credit_card_payment_method").show();
					} else {
						$(".is_show_online_banking").show();
						$("#upload-file").prop('required', true);
						$("#datepicker").prop('required', true);
						$("#time_").prop('required', true);
					}
				});
				
				//console.log(rel);
				$('#payment_method_').val(rel);
				$('.display-slide').hide();
				$('.display-slide[rel=' + rel + ']').fadeIn();
				$(".select-display-slide > li").removeClass("active");
				$(this).addClass("active");
			});			
		});

		function checkCoupon() {
			if($("#coupon_code").val() == '') {
				alert('กรุณากรอกรหัสคูปอง / โปรโมชัน');

				$("#coupon_code").focus();
			} else {
				$.post('index.php?route=checkout/cart/ajaxShippingAndCoupon', { coupon_code: $("#coupon_code").val() }, function(data) {
					var data_split = data.split('!@#$%^&*()_');

					if(data_split[4] == 'true') {
						$(".bSpanSubTotal").html(data_split[0]);
						$(".spanClassReceiveMe").html(data_split[1]);
						$(".spanClassDiscount").html(data_split[2]);
						$(".spanClassTotal").html(data_split[3]);

						//alert(data_split[4]);
					} else {
						$("#coupon_code").val('');

						$(".bSpanSubTotal").html(data_split[0]);
						$(".spanClassReceiveMe").html(data_split[1]);
						$(".spanClassDiscount").html(data_split[2]);
						$(".spanClassTotal").html(data_split[3]);

						alert('รหัสคูปองไม่ถูกต้อง');

						//alert(data_split[4]);
					}
				});
			}
		}

		function setTotalNormal() {
			$(".credit_card_payment_method").hide();
			$.post('index.php?route=checkout/cart/ajaxSetNormal', { coupon_code: $("#coupon_code").val() }, function(data) {
				var data_split = data.split('!@#$%^&*()_');

				$(".bSpanSubTotal").html(data_split[0]);
				$(".spanClassReceiveMe").html(data_split[1]);
				$(".spanClassDiscount").html(data_split[2]);
				$(".spanClassTotal").html(data_split[3]);
			});
		}

		function setTotal50Percent() {
			if(confirm('ยืนยันมัดจำ 50% ?')) {
				$.post('index.php?route=checkout/cart/ajaxTotal50Percent', { coupon_code: $("#coupon_code").val() }, function(data) {
					var data_split = data.split('!@#$%^&*()_');

					$(".bSpanSubTotal").html(data_split[0]);
					$(".spanClassReceiveMe").html(data_split[1]);
					$(".spanClassDiscount").html(data_split[2]);
					$(".spanClassTotal").html(data_split[3]);

					location.reload();
				});
			}
		}
	</script>
	<script>
