		function onblurQty(product_id) {
			var qty = $("#qty_" + product_id).val();

			$.post('index.php?route=checkout/cart/ajaxUpdateCart', { qty: qty, product_id: product_id }, function(data) {
				location.reload();
				
				var data_split = data.split('!@#$%^&*()(*&^%$#@!');
				$(".class_sub_total").html(data_split[1]);
				$(".class_discount").html(data_split[2]);
				$(".class_shipping").html(data_split[3]);
				$(".class_total").html(data_split[4]);
				$(".class_cart_basket").html(data_split[5]);
			});
		}

		function diffQty(product_id) {
			var qty = $("#qty_" + product_id).val();

			if(qty > 1) {
				qty--;

				$("#qty_" + product_id).val(qty);

				$.post('index.php?route=checkout/cart/ajaxUpdateCart', { qty: qty, product_id: product_id }, function(data) {
					location.reload();

					var data_split = data.split('!@#$%^&*()(*&^%$#@!');
					$(".class_sub_total").html(data_split[1]);
					$(".class_discount").html(data_split[2]);
					$(".class_shipping").html(data_split[3]);
					$(".class_total").html(data_split[4]);
					$(".class_cart_basket").html(data_split[5]);
				});
			}
		}

		function plusQty(product_id) {
			var qty = $("#qty_" + product_id).val();

			qty++;

			$("#qty_" + product_id).val(qty);
			
			$.post('index.php?route=checkout/cart/ajaxUpdateCart', { qty: qty, product_id: product_id }, function(data) {
				location.reload();

				var data_split = data.split('!@#$%^&*()(*&^%$#@!');
				$(".class_sub_total").html(data_split[1]);
				$(".class_discount").html(data_split[2]);
				$(".class_shipping").html(data_split[3]);
				$(".class_total").html(data_split[4]);
				$(".class_cart_basket").html(data_split[5]);
			});
		}

		function clickCheckboxAll() {
			if($("#check_all").is(":checked") == true) {
				$(".item-check").prop('checked', true);
			} else {
				$(".item-check").prop('checked', false);
			}
		}
	</script>

