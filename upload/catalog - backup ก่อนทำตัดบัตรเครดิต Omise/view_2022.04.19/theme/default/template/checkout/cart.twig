	<script>
		$('#switch').on("change", function() {
			if ($('#switch').is(':checked')) {
				$('.box01').slideDown();
			} else {
				$('.box01').slideUp();
			}
		});

	</script>
	<script>
		function showIfChecked(radioName, value, element) {
			var $radios = $('[name="' + radioName + '"]');
			var $element = $('#' + element);

			if ($element.length == 0) {
				return false;
			}

			$element.hide();

			$radios.on('change', function() {
				var $this = $(this);
				var check = $this.val() == value && $this.is(':checked');
				$element[check ? 'show' : 'hide']();
			});
		}

		$(document).ready(function() {
			showIfChecked('check1', 3, 'check1-other');
			showIfChecked('check1', 1, 'check3-other');
		});

		function changeProvince(province_id) {
			$.post('index.php?route=member/member/ajaxChangeProvince', { province_id: province_id }, function(data) {
				$("#customer_amphur").html(data);
			});
		}

		function changeAmphur(amphur_id) {
			$.post('index.php?route=member/member/ajaxChangeAmphur', { amphur_id: amphur_id }, function(data) {
				$("#customer_tumbol").html(data);
			});
