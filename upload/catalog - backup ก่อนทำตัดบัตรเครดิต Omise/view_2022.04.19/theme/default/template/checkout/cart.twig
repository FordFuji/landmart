				$("#customer_invoice_amphur").html(data);
			});
		}

		function changeAmphurInvoice(amphur_id) {
			$.post('index.php?route=member/member/ajaxChangeAmphur', { amphur_id: amphur_id }, function(data) {
				$("#customer_invoice_tumbol").html(data);
			});
		}

		function addressSame() {
			if($("#addressSame_").is(":checked") == true) {
				$("#customer_invoice_name").val($("#firstname").val() + ' ' + $("#lastname").val());
				$("#customer_invoice_address1").val($("#customer_address1").val());
				$("#customer_invoice_address2").val($("#customer_address2").val());
				$("#customer_invoice_postcode").val($("#customer_postcode").val());
				$("#customer_invoice_province").val($("#customer_province").val());
				$("#customer_invoice_amphur").val($("#customer_amphur").val());
				$("#customer_invoice_tumbol").val($("#customer_tumbol").val());
			} else if($("#addressSame_").is(":checked") == false) {
				$("#customer_invoice_name").val('');
				$("#customer_invoice_address1").val('');
				$("#customer_invoice_address2").val('');
				$("#customer_invoice_postcode").val('');
				$("#customer_invoice_province").val('');
				$("#customer_invoice_amphur").val('');
				$("#customer_invoice_tumbol").val('');
			}
		}

		function receiveProduct(type) {
			if(type == 'cod') {
				$('#firstname').prop('required', true);
				$('#lastname').prop('required', true);
				$('#telephone').prop('required', true);
				$('#email').prop('required', true);
				$('#customer_address1').prop('required', true);
				$('#customer_postcode').prop('required', true);
				$('#customer_province').prop('required', true);
				$('#customer_amphur').prop('required', true);
				$('#customer_tumbol').prop('required', true);

				$('#firstname_me').prop('required', false);
				$('#lastname_me').prop('required', false);
				$('#telephone_me').prop('required', false);
				$('#address_me').prop('required', false);
				$('#email_me').prop('required', false);

				$("#check1-other").show();
				$("#check-me").hide();

				$.post("index.php?route=checkout/cart/ajaxShippingAndCoupon", { coupon_code: $("#coupon_code").val(), shipping_type: 'cod' }, function(data) {
					var data_split = data.split('!@#$%^&*()_');

					$(".bSpanSubTotal").html(data_split[0]);
					$(".spanClassReceiveMe").html(data_split[1]);
					$(".spanClassDiscount").html(data_split[2]);
					$(".spanClassTotal").html(data_split[3]);

					//alert(data_split[4]);
				});
			} else if(type == 'me') {
				$('#firstname').prop('required', false);
				$('#lastname').prop('required', false);
				$('#telephone').prop('required', false);
				$('#email').prop('required', false);
				$('#customer_address1').prop('required', false);
				$('#customer_postcode').prop('required', false);
				$('#customer_province').prop('required', false);
				$('#customer_amphur').prop('required', false);
				$('#customer_tumbol').prop('required', false);

				$('#firstname_me').prop('required', true);
				$('#lastname_me').prop('required', true);
				$('#telephone_me').prop('required', true);
				$('#address_me').prop('required', true);
				$('#email_me').prop('required', true);

				$("#check1-other").hide();
				$("#check-me").show();

				$.post("index.php?route=checkout/cart/ajaxShippingAndCoupon", { coupon_code: $("#coupon_code").val(), shipping_type: 'me' }, function(data) {
					var data_split = data.split('!@#$%^&*()_');

					$(".bSpanSubTotal").html(data_split[0]);
					$(".spanClassReceiveMe").html(data_split[1]);
					$(".spanClassDiscount").html(data_split[2]);
					$(".spanClassTotal").html(data_split[3]);

					//alert(data_split[4]);
				});
			}
		}

		function checkCoupon() {
			if($("#coupon_code").val() == '') {
				alert('กรุณากรอกรหัสคูปอง / โปรโมชัน');

				$("#coupon_code").focus();
			} else {
				$.post('index.php?route=checkout/cart/ajaxShippingAndCoupon', { coupon_code: $("#coupon_code").val() }, function(data) {
					var data_split = data.split('!@#$%^&*()_');

					if(data_split[4] == 'true') {
						$(".bSpanSubTotal").html(data_split[0]);
						$(".spanClassReceiveMe").html(data_split[1]);
						$(".spanClassDiscount").html(data_split[2]);
						$(".spanClassTotal").html(data_split[3]);

						//alert(data_split[4]);
					} else {
						$("#coupon_code").val('');

						$(".bSpanSubTotal").html(data_split[0]);
						$(".spanClassReceiveMe").html(data_split[1]);
						$(".spanClassDiscount").html(data_split[2]);
						$(".spanClassTotal").html(data_split[3]);

						alert('รหัสคูปองไม่ถูกต้อง');

						//alert(data_split[4]);
					}
				});
			}
		}

		function deleteCart(product_id) {
			if(confirm("ยืนยันการลบ") == true) {
				$.post("index.php?route=checkout/cart/ajaxDeleteCart", { product_id: product_id }, function(data) {
					/*var data_split = data.split('!@#$%^&*()_');

					$(".bSpanSubTotal").html(data_split[0]);
					$(".spanClassReceiveMe").html(data_split[1]);
					$(".spanClassDiscount").html(data_split[2]);
					$(".spanClassTotal").html(data_split[3]);

					//alert(data_split[4]);
					*/

					window.location.href = 'index.php?route=checkout/cart';
				});
			}
