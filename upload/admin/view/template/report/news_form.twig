{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-product" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid"> 
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> ข่าวสารและโปรโมชัน</h3>
      </div>
      <div class="panel-body">
        <form action="{% if id != '' %}index.php?route=report/report/edit&id={{ id }}&user_token={{ user_token }}{% else %}index.php?route=report/report/add&user_token={{ user_token }}{% endif %}" method="post" enctype="multipart/form-data" id="form-product" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2" style="text-align: right;">วันที่</label>
            <div class="col-sm-10">
              <input type="text" name="news_datetime" value="{{ news.news_datetime }}" placeholder="" id="news_datetime" class="form-control" required>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2" style="text-align: right;">หัวข้อ</label>
            <div class="col-sm-10">
              <input type="text" name="news_topic" class="form-control" value="{{ news.news_topic }}" required>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2" style="text-align: right;">คำอธิบาย</label>
            <div class="col-sm-10">
              <textarea name="news_description" class="form-control" rows="3" required>{{ news.news_description }}</textarea>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2" style="text-align: right;">รายละเอียด</label>
            <div class="col-sm-10">
              <textarea name="news_detail" class="form-control" rows="3" data-toggle="summernote" required>{{ news.news_detail }}</textarea>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2" style="text-align: right;">รูปภาพ</label> Recommend 376 x 217 px
            <div class="col-sm-10">
              <a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{% if(news.news_image != '') %}../image/{{news.news_image}}{% else %}{{'../image/cache/no_image-100x100.png'}}{% endif %}" alt="" title="" data-placeholder="../image/cache/no_image-100x100.png" style="width: 100px;"></a><input type="hidden" name="news_image" value="{{news.news_image}}" id="news_image">
            </div>
          </div>
          {# <div class="form-group">
            <label class="col-sm-2" style="text-align: right;">วีดีโอ</label>
            <div class="col-sm-10">
              <input type="text" name="news_embed_video" class="form-control" value="{{ news.news_embed_video }}" required>
            </div>
          </div> #}
        </form>
      </div>
    </div>
  </div>
  <link href="view/javascript/codemirror/lib/codemirror.css" rel="stylesheet" />
  <link href="view/javascript/codemirror/theme/monokai.css" rel="stylesheet" />
  <script type="text/javascript" src="view/javascript/codemirror/lib/codemirror.js"></script> 
  <script type="text/javascript" src="view/javascript/codemirror/lib/xml.js"></script> 
  <script type="text/javascript" src="view/javascript/codemirror/lib/formatting.js"></script> 
  <script type="text/javascript" src="view/javascript/summernote/summernote.js"></script>
  <link href="view/javascript/summernote/summernote.css" rel="stylesheet" />
  <script type="text/javascript" src="view/javascript/summernote/summernote-image-attributes.js"></script> 
  <script type="text/javascript" src="view/javascript/summernote/opencart.js"></script> 

  <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
  <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
  <script>
  $( function() {
    $( "#news_datetime" ).datepicker({ dateFormat: 'yy-mm-dd' });
  } );
  </script>

  {{ footer }}
