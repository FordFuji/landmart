{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" name="submit_vdo" form="form-product" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary" value="."><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid"> 
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> ข่าวสารและโปรโมชัน</h3>
      </div>
      <div class="panel-body">
        <form action="index.php?route=report/report/news&user_token={{ user_token }}" method="post" enctype="multipart/form-data" id="form-product" class="form-horizontal">
          <div class="form-group">
            <div class="col-sm-2">&nbsp;
            </div>
            <div class="col-sm-10">
              <input type="button" value=" + " onclick="addVDONews();">
            </div>
          </div>
{% if vdo_news %}
  {% set i = 1 %}
  {% for vdo in vdo_news %}
    {% set i = i + 1 %}
        <div id="div_news_{{ i }}">
          <div class="form-group">
            <label class="col-sm-2" style="text-align: right;">วีดีโอข่าวสารและโปรโมชัน</label>
            <div class="col-sm-9">
              <input type="text" name="vdo_news_embed_youtube[]" class="form-control" value="{{ vdo.vdo_news_embed_youtube }}" required>
            </div>
            <div class="col-sm-1">
              <input type="button" value=" - " onclick="deleteVDONews({{ i }});">
            </div>
          </div>
        </div>
  {% endfor %}
{% else %}
          <div class="form-group">
            <label class="col-sm-2" style="text-align: right;">วีดีโอข่าวสารและโปรโมชัน</label>
            <div class="col-sm-9">
              <input type="text" name="vdo_news_embed_youtube[]" class="form-control" required>
            </div>
            <div class="col-sm-1">
              <input type="button" value=" - " onclick="deleteVDONews(1);">
            </div>
          </div>
{% endif %}
          <span id="span_news_promotion"></span>
{% if i %}
	{% set i = i - 1 %}
{% else %}
	{% set i = 1 %}
{% endif %}
        </form>
      </div>
    </div>
  </div>
  <link href="view/javascript/codemirror/lib/codemirror.css" rel="stylesheet" />
  <link href="view/javascript/codemirror/theme/monokai.css" rel="stylesheet" />
  <script type="text/javascript" src="view/javascript/codemirror/lib/codemirror.js"></script> 
  <script type="text/javascript" src="view/javascript/codemirror/lib/xml.js"></script> 
  <script type="text/javascript" src="view/javascript/codemirror/lib/formatting.js"></script> 
  <script type="text/javascript" src="view/javascript/summernote/summernote.js"></script>
  <link href="view/javascript/summernote/summernote.css" rel="stylesheet" />
  <script type="text/javascript" src="view/javascript/summernote/summernote-image-attributes.js"></script> 
  <script type="text/javascript" src="view/javascript/summernote/opencart.js"></script> 

  <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
  <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
  <script>
  $( function() {
    $( "#news_datetime" ).datepicker({ dateFormat: 'yy-mm-dd' });
  } );

  function addVDONews(i) {
    i++;

    $('<div id="div_news_' + i + '"><div class="form-group"><label class="col-sm-2" style="text-align: right;">วีดีโอข่าวสารและโปรโมชัน</label><div class="col-sm-9"><input type="text" name="vdo_news_embed_youtube[]" class="form-control" required></div><div class="col-sm-1"><input type="button" value=" - " onclick="deleteVDONews(' + i + ');"></div></div></div>').clone().appendTo("#span_news_promotion");
  }

  function deleteVDONews(i) {
    if(i <= 1) {

    } else {
      $("#div_news_" + i).remove();
      console.log(i);
    }
  }
  </script>

  {{ footer }}
