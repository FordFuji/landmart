                            </div>
                        </div>
                    </div>

{% for order in orderAllCtrl %}
    {% set check = false %}
    {% for order_product in orderCtrl %}
        {% if order.order_id == order_product.order_id %}
            {% set check = true %}
        {% endif %}
    {% endfor %}

    {% if check == true %}
                    <table class="table table_box_c table-bordered mt-4">
                        <thead>
                            <tr>
                                <th class="text-center">
                                    <input type="checkbox" class="selectAll" />
                                </th>
                                <th>หมายเลขการสั่งซื้อ: <span class="ordernumber">{{ order.invoice_no }}</span> </th>
                                <th>ประเภทสินค้า :
        {% set category_ = '' %}
        {% set j = 0 %}
        {% for order_product in orderCtrl %} 
            {# {{ order.order_id ~ ' == ' ~ order_product.order_id ~ ' or ' ~ order_product.product_id ~ ' == ' ~ categoryCtrl.product_id }} <br> #}
            {% if order.order_id == order_product.order_id and order_product.product_id == categoryCtrl.product_id %}
                {% set category_ = category_ ~ categoryCtrl.name ~ ' + ' %}

                {% set j = j + 1 %}
            {% endif %}
        {% endfor %}
        {{ category_|slice(0, -3) }}
                                </th>
                                <th colspan="3" class="text-right">ชื่อผู้ซื้อ: <span class="ordernumber" onclick="showUnShowSummaryData('{{ order.order_id }}');">{{ order.firstname }}&nbsp;{{ order.lastname }}</span></th>
                            </tr>
                            <tr style="display: none;" class="order_no_{{ order.order_id }}">
                                <th align="left" colspan="6">รายละเอียดการสั่งซื้อสำหรับคำสั่งซื้อหมายเลข&nbsp;{{ order.invoice_no }}</th>
                            </tr>
                            <tr style="display: none;" class="order_no_{{ order.order_id }}" valign="top">
                                <td align="left" valign="top" colspan="2">
                                    <b>ข้อมูลของลูกค้า</b><hr>
                                    วันที่:&nbsp;<b>{{ order.date_added }}</b><br>
                                    ลูกค้า:&nbsp;{{ order.firstname }}&nbsp;{{ order.lastname }}<br>
                                    หมายเลขโทรศัพท์:&nbsp;{{ order.telephone }}<br>
                                    วิธีการชำระเงิน:&nbsp;{{ order.payment_method }}<br>
                                    เลขที่ใบกำกับภาษี&nbsp;
                                </td>
                                <td align="left" valign="top">
                                    <b>ข้อมูลการทำธุรกรรม</b><hr>
        {% if order.payment_method == 'จองสินค้า 50%' %}
                                    {{ order.payment_method2 }}: {{ order.total|number_format(2, '.', ',') }}<br>
                                    ยอดรวม COD: {{ order.total|number_format(2, '.', ',') }}<br>
        {% else %}
                                    {{ order.payment_method }}: {{ order.total|number_format(2, '.', ',') }}<br>
        {% endif %}
                                    ค่าธรรมเนียมการจัดส่ง: +{{ order.shipping_price }}<br>
                                    LANDMART Discount Total:&nbsp;-{{ order.discount_price }}<br>
        {% if order.payment_method == 'จองสินค้า 50%' %}
                                    จำนวนเงินรวมทั้งหมด:&nbsp;{% set order_total_ = order.total * 2 %} {{ order_total_|number_format(2, '.', ',') }}
        {% else %}
                                    จำนวนเงินรวมทั้งหมด:&nbsp;{{ order.total|number_format(2, '.', ',') }}<br>&nbsp;
        {% endif %}
                                </td>
                                <td align="left" valign="top">
                                    <b>ที่อยู่เรียกเก็บเงิน</b><hr>
        {% if order.payment_firstname == '' %}
            {% if order.receive_product == 'รับสินค้าตามที่อยู่ปลายทาง' %}
                                        {{ order.shipping_firstname }}&nbsp;{{ order.shipping_lastname }}<br>
                {% if order.shipping_company != '' %}
                                        {{ order.shipping_company }}<br>
                {% endif %}
                                        {{ order.shipping_address_1 }}
                                        {{ order.shipping_address_2 }}<br>
                {% for tumbol_ in tumbol %}
                    {% if tumbol_.DISTRICT_ID == order.shipping_tumbol %}
                                        {{ tumbol_.DISTRICT_NAME }}
                    {% endif %}
                {% endfor %},
                                        &nbsp;
                {% for amphur_ in amphur %}
                    {% if amphur_.AMPHUR_ID == order.shipping_amphur %}
                        {{ amphur_.AMPHUR_NAME }}
                    {% endif %}
                {% endfor %}
                                        <br>
                {% for province_ in province %}
                    {% if province_.PROVINCE_ID == order.shipping_city %}
                        {{ province_.PROVINCE_NAME}}
                    {% endif %}
                {% endfor %}
                                        <br>
                                        {{ order.shipping_postcode }}                       
            {% else %}
                                        {{ order.shipping_firstname }}&nbsp;{{ order.shipping_lastname }}<br>
                                        {{ order.shipping_address_1 }}
                                        {{ order.shipping_address_2 }}
            {% endif %}   
        {% else %}
                                        {{ order.payment_firstname }}&nbsp;{{ order.payment_lastname }}<br>
                                        {{ order.payment_address_1 }}&nbsp;{{ order.payment_address_2 }}<br>
            {% for tumbol_ in tumbol %}
                {% if tumbol_.DISTRICT_ID == order.payment_tumbol %}
                                    {{ tumbol_.DISTRICT_NAME }}
                {% endif %}
            {% endfor %}
                                        ,&nbsp;
            {% for amphur_ in amphur %}
                {% if amphur_.AMPHUR_ID == order.payment_amphur %}
                    {{ amphur_.AMPHUR_NAME }}
                {% endif %}
            {% endfor %}
                                        <br>
            {% for province_ in province %}
                {% if province_.PROVINCE_ID == order.payment_city %}
                    {{ province_.PROVINCE_NAME}}
                {% endif %}
            {% endfor %}
                                        <br>
                                        {{ order.payment_postcode }}
        {% endif %}              
                                        <br>&nbsp;           
                                </td>
                                <td align="left" colspan="2" valign="top">
                                    <b>ที่อยู่สำหรับจัดส่ง</b><hr>
        {% if order.receive_product == 'รับสินค้าตามที่อยู่ปลายทาง' %}
                                    {{ order.shipping_firstname }}&nbsp;{{ order.shipping_lastname }}<br>
            {% if order.shipping_company != '' %}
                                    {{ order.shipping_company }}<br>
            {% endif %}
                                    {{ order.shipping_address_1 }}
                                    {{ order.shipping_address_2 }}<br>
            {% for tumbol_ in tumbol %}
                {% if tumbol_.DISTRICT_ID == order.shipping_tumbol %}
                                    {{ tumbol_.DISTRICT_NAME }}
                {% endif %}
            {% endfor %}
                                    ,&nbsp;
            {% for amphur_ in amphur %}
                {% if amphur_.AMPHUR_ID == order.shipping_amphur %}
                    {{ amphur_.AMPHUR_NAME }}
                {% endif %}
            {% endfor %}
                                    <br>
            {% for province_ in province %}
                {% if province_.PROVINCE_ID == order.shipping_city %}
                    {{ province_.PROVINCE_NAME}}
                {% endif %}
            {% endfor %}
                                    <br> 
                                    {{ order.shipping_postcode }}                       
        {% else %}
                                    {# {{ order.shipping_firstname }}&nbsp;{{ order.shipping_lastname }}<br>
                                    {{ order.shipping_address_1 }}
                                    {{ order.shipping_address_2 }} #}
        {% endif %}
                                    <br>&nbsp;
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="bornone">
                                <td class="text-center">
                                    <input type="checkbox" name="order_id[]" value="{{ order.order_id }}" />
                                </td>
                                <td colspan="4"> แพ็คเกจ <br> ({{ j }} รายการสินค้า)</td>
                            </tr>
        {% set i = 0 %}
        {% for order_product in orderCtrl %}
            {% if order.order_id == order_product.order_id %}
                {% set i = i + 1 %}
                            <tr>
                                <td>{{ i }}</td>
                                <td>
                                    <div class="row no-gutters">
                                        <div class="col-md-2">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                fill="currentColor" class="bi bi-box-seam" viewBox="0 0 16 16">
                                                <path
                                                    d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2l-2.218-.887zm3.564 1.426L5.596 5 8 5.961 14.154 3.5l-2.404-.961zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923l6.5 2.6zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464L7.443.184z" />
                                            </svg> * 1
                                        </div>
                                        <div class="col-md-2">
                                            <img src="../image/{{ order_product.image }}" class="img-fluid" alt="">
                                        </div>
                                        <div class="col-md-8">
                                            <div class="productcontent">
                                                <h4>{{ order_product.name }}</h4> {% if(order_product.size_color != '') %} ({{ order_product.size_color }}) {% endif %}
                {% if order_product.product_landmart == 'Yes' %}
                                                <span class="smtxt">LANDMART</span> <br>
                {% endif %}
                                                <span class="smtxtg">รุ่น {{ order_product.model }} {% if order_product.size_color %}&nbsp;{{ '(' ~ order_product.size_color ~ ')' }} {% endif %}</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="bigprice">
                                        {{ order_product.datetime_create }}
                                    </div>
                {% set check = false %}
                {% set invoice_no = 0 %}
                {% if payment %}
                    {% for p in payment %}
                        {% if p.invoice_no == order_product.invoice_no %}
                            {% set check = true %}
                            {% set invoice_no = 'link_' ~ p.invoice_no %}
                        {% endif %}
                    {% endfor %}
                {% endif %}

                {% if check == true %}
                                    <div class="smtxtg">รอตรวจสอบ<br><a href="index.php?route=sale/payment&user_token={{ user_token }}#{{ invoice_no }}">Slip</a></div>
                {% else %}
                                    <div class="smtxtg">รอการชำระเงิน</div>
                {% endif %}
                                </td>
                                <td class="text-center">
                                    <div class="bigprice">{{ order_product.total|number_format(2, '.', ',') }}</div>
                                    <div class="smtxtg2">รวมค่าจัดส่ง</div>
                                </td>
                                <td class="text-center">
                                    <div class="bigprice">
                                        {{ order_product.datetime_create }}
                                    </div>
                                    <div class="smtxtg2">Invoice printed <br> Picking list printed</div>
                {% if order_product.status == '1' and order_product.payment_method == 'Online Banking' %}
                                    <br><a href="index.php?route=sale/payment&user_token={{ user_token }}&invoice_no={{ order_product.invoice_no }}">ตรวจสอบสลิป</a><br>
                {% endif %}
                                    {# Cancel Copy ตรงนี้มา #}<a data-fancybox data-src="#cancel_box_{{ order_product.order_product_id }}" href="javascript:;" class="btn btn-confirm" data-width="900" data-height="400" style="color: #1e91cf;">ยกเลิกออเดอร์</a>{# End Cancel Copy ตรงนี้มา #}
                                </td>
                            </tr>
            {% endif %}
        {% endfor %}
                        </tbody>
                    </table>
    {% endif %}
{% endfor %}

    </div>
</form>
<div class="paginator" align="center">
{% for f in 1..count_page %}
    {% if f == count_page %}
        <a href="index.php?route=sale/order&page={{ f }}&user_token={{ user_token }}">{{ f }}</a>
    {% elseif f == page %}
        {{ f }} |
    {% else %}
        <a href="index.php?route=sale/order&page={{ f }}&user_token={{ user_token }}">{{ f }}</a> |  
    {% endif %}
{% endfor %}
</div>

{# Cancel Copy ตรงนี้มา #}
{% set no = 0 %}
{% for order_product in orderCtrl %}
    <div style="display: none;" id="cancel_box_{{ order_product.order_product_id }}">
        <form action="index.php?route=sale/order/UpdateCancel&user_token={{ user_token }}&callback=sale/order" method="post" id="myform_{{ no }}">
        <h2>Cancel โดย Landmart</h2>
        <table class="table table-invoice-fill table-bordered">
            <thead>
                <tr>
                    <th>หมายเลขคำสั่งซื้อ</th>
                    <th>สินค้า</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{ order_product.invoice_no }}</td>
                    <td>{{ order_product.name }}</td>
                </tr>
                <tr>
                    <th>เหตุผล</th>
                    <th>หมายเหตุ</th>
                </tr>
                <tr>
                    <td valign="top">
                        <select name="cancel_reason" class="form-control">
                            <option value="ไม่มีสินค้าชั่วคราว">ไม่มีสินค้าชั่วคราว</option>
                            <option value="ไม่สามารถส่งได้">ไม่สามารถส่งได้</option>
                        </select>
                    </td>
                    <td>
                        <textarea name="cancel_remark" class="form-control" rows="3" required>

                        </textarea>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="group_bottom">
            <div class="row">
                <div class="col-md-4">
                    &nbsp;
                </div>
                <div class="col-md-8 text-md-right">
                    <a href="#" class="btn btn-sq-no">ปิด</a>
                    <a href="javascript:$('#myform_{{ no }}').submit();" class="btn btn-sq-blue">บันทึกเหตุผลในการยกเลิก</a>
                    <input type="hidden" name="order_product_id" value="{{ order_product.order_product_id }}">
                </div>
            </div>
        </div>
        </form>
    </div>
    {% set no = no + 1 %}
{% endfor %}
{# End Cancel Copy ตรงนี้มา #}

<script>
function cancelOrder() {
    $("#formCancel").submit();
}

function showUnShowSummaryData(order_id) {
    $(".order_no_" + order_id).toggle();
}
</script>

