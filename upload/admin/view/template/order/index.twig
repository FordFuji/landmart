{{ header }}
<script type="text/javascript">
    $(document).ready(function () {

        $('.selectAll').click(function (e) {
            $(this).closest('table').find('td input:checkbox').prop('checked', this.checked);
        });
    });
</script>
{{ column_left }}
<style>
    .order_status li:nth-child(1) {
        border: 2px solid lightgray;
    }

    .order_status li:nth-child(1) a {
        color: blue;
    }
</style>

    <div class="container" style="overflow: auto; padding-left: 200px;">
        <div class="row">
            <div class="col">
                <div class="title_order">
                    <h1>คำสั่งซื้อ</h1>
                    <span>รายละเอียดทั่วไปของคำสั่งซื้อ</span>
                </div>
            </div>
        </div>
        <form action="index.php?route=sale/order/submitCancel&user_token={{ user_token }}" method="post" id="formCancel">
        <div class="row">
            <div class="col">
                {{ status }}
            </div>
                    <div class="row mt-3">
                        <div class="col-md-3">
                            <div class="selectbox_status">
                                <div class="dropdown">
                                    <button class="dropdown-toggle" type="button" id="dropdownMenuButton"
